class Solution {
    public int minimumDistance(int[] nums) {
        int n = nums.length;
        int ans = Integer.MAX_VALUE;

        int[][] pos = new int[n + 1][3];
        int[] count = new int[n + 1];

        for (int i = 0; i < n; i++) {
            int x = nums[i];

            if (count[x] < 3) {
                pos[x][count[x]] = i;
            } else {
                pos[x][0] = pos[x][1];
                pos[x][1] = pos[x][2];
                pos[x][2] = i;
            }

            count[x]++;

            if (count[x] >= 3) {
                int a = pos[x][0];
                int b = pos[x][1];
                int c = pos[x][2];

                int distance = 2 * (c - a);
                ans = Math.min(ans, distance);
            }
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}
